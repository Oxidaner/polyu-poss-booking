# 复制为 .env 并填写（.env 已被 gitignore，绝不入库）
# POSS 登录（必填）
POSS_NETID=
POSS_PASSWORD=
POSS_FB_USER_ID=657032

# 微信推送（PushPlus / Server酱 二选一或都配）
PUSHPLUS_TOKEN=
SERVERCHAN_KEY=

# 邮件（QQ邮箱示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# 可选：自定义目标时段（默认：周二12:30-18:00 + 周三四五14:30-18:00）
# TARGET_SLOTS=[{"days":[1],"from":"12:30","to":"18:00"},{"days":[2,3,4],"from":"14:30","to":"18:00"}]
