# 复制为 .env 并填写（.env 已被 gitignore，绝不入库）
#
# 其实不用手填：跑 `python3 poss_ui.py`，页面上「账号与自动抢位」会帮你写这个文件，
# 自动 chmod 600，密码也不会回显到页面上。这里留着是给习惯命令行的人。

# POSS 登录（必填）
POSS_NETID=
POSS_PASSWORD=
POSS_FB_USER_ID=657032

# 多账号可在网页添加，也可按编号手动填写；每个账号须有不同 NetID。
# POSS_NETID_2=
# POSS_PASSWORD_2=

# 微信推送（PushPlus / Server酱 二选一或都配）
PUSHPLUS_TOKEN=
SERVERCHAN_KEY=

# 邮件（QQ邮箱示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# 馆列表与目标时段配置见 config.json（也可用 POSS_CONFIG 环境变量传 JSON 覆盖）
